FROM python:3.12-slim

# --- Herramientas de trabajo + Google Cloud CLI -----------------------------
RUN apt-get update && apt-get install -y apt-transport-https ca-certificates gnupg curl

RUN curl https://packages.cloud.google.com/apt/doc/apt-key.gpg | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg

RUN echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" | tee -a /etc/apt/sources.list.d/google-cloud-sdk.list

RUN apt-get update && apt-get install -y git vim net-tools build-essential google-cloud-cli

# --- Librerias de sistema que necesita OpenCV ------------------------------
# En Dockerfile.prod tambien estan: sin ellas "import cv2" falla.
RUN apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# --- uv, misma version que en produccion ----------------------------------
COPY --from=ghcr.io/astral-sh/uv:0.10.9 /uv /bin/uv

# IMPORTANTE: el entorno virtual va FUERA de /ws/code.
# /ws/code es un bind mount de tu carpeta en macOS, y un .venv construido para
# darwin/arm64 no funciona dentro de un contenedor Linux. Mandandolo a /opt/venv
# el contenedor tiene su propio entorno sin pisar el de tu Mac.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"

ENV YOLO_CONFIG_DIR=/tmp/ultralytics

WORKDIR /ws/code

ENV PYTHONPATH=/ws/code/application
